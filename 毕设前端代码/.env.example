# Copy this template to the project-root .env or set ENV_FILE explicitly.
# Root .env.local overrides the file; process environment overrides both.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:3001
DB_HOST=your-aiven-host
DB_PORT=your-aiven-port
DB_NAME=your-database
DB_USER=your-user
DB_PASSWORD=
# CA path is relative to the selected base .env; inline PEM is also supported.
DB_SSL_CA=jrs-ca.pem
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
UPLOAD_DIR=./uploads/private
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-qq-address@qq.com
# QQ SMTP authorization code, not the QQ login password.
SMTP_PASS=
SMTP_FROM=your-qq-address@qq.com
MAIL_ALLOW_SMTP=false
