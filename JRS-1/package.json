{
  "name": "jrs-integrated",
  "version": "1.0.0",
  "private": true,
  "description": "Integrated JRS: shared login, applicant portal and the original HR interface",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node --watch server/index.mjs",
    "build": "node scripts/build.mjs",
    "deploy:check": "node scripts/check-deployment.mjs",
    "deploy:export-schema": "node scripts/export-production-schema.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:english": "node scripts/check-english.mjs",
    "db:setup": "node scripts/setup-database.mjs",
    "test:workflow": "node --test tests/default-boundary.mysql.mjs",
    "test:experimental": "node --test tests/workflow.mysql.mjs",
    "build:experimental": "node scripts/build.mjs --experimental-applicant"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.6",
    "country-state-city": "3.2.1",
    "dotenv": "^18.0.0",
    "express": "5.2.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "file-type": "^22.1.1",
    "helmet": "^8.1.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "^0.544.0",
    "multer": "^2.4.0",
    "mysql2": "3.24.4",
    "nodemailer": "^10.0.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "sequelize": "6.37.8",
    "sharp": "0.35.4",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jest": "30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jsdom": "^26.1.0",
    "supertest": "^7.3.1",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  }
}
