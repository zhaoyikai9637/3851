# Render Free runtime template. Populate values privately; never commit a completed file.
NODE_ENV=production
HOST=0.0.0.0
JRS_ENV_FILE=
# Scratch directory only. Durable files use the private Supabase bucket below.
JRS_DATA_DIR=/data
APP_ORIGIN=https://YOUR-SERVICE.onrender.com
DB_MODE=production
DB_HOST=
DB_EXPECTED_HOST=
DB_PORT=
DB_NAME=jrs_production
DB_USER=jrs_production_app
DB_PASSWORD=
DB_SSL_CA_PEM=
SESSION_SECRET=
RESET_SECRET=
ENABLE_APPLICANT_PORTAL=true
ENABLE_EXPERIMENTAL_APPLICANT_PORTAL=false
SMTP_ENABLED=false
SMTP_MODE=production
JRS_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=jrs-files

# Candidate verification codes through HTTPS; HR SMTP remains disabled.
CANDIDATE_MAIL_PROVIDER=mailjet
CANDIDATE_MAIL_MODE=sandbox
CANDIDATE_MAIL_ALLOWLIST=your-test-mailbox@example.com
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=JRS
