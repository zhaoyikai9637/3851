# Enter real values privately in Railway Variables; never commit a completed file.
NODE_ENV=production
HOST=0.0.0.0
# Railway injects PORT. Docker uses 8080 when no platform port is supplied.
JRS_ENV_FILE=
JRS_DATA_DIR=/data
ENABLE_EXPERIMENTAL_APPLICANT_PORTAL=false
APP_ORIGIN=https://YOUR-SERVICE.up.railway.app
DB_MODE=production
DB_HOST=
DB_EXPECTED_HOST=
DB_PORT=3306
DB_NAME=jrs_production
DB_USER=jrs_production_app
DB_PASSWORD=
# Paste the provider CA certificate as a multiline Railway variable.
DB_SSL_CA_PEM=
SESSION_SECRET=
RESET_SECRET=
# Test deployment on Hobby: mail stays disabled. QQ SMTP was a local test only.
# Public mail needs a separate HTTPS adapter or Pro; do not enable SMTP on Hobby.
SMTP_ENABLED=false
SMTP_MODE=production
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
