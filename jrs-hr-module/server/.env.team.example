# Shared team integration template. Copy to .env and replace every placeholder locally.
# Never commit the resulting .env file or send credentials through the repository.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173

DB_HOST=replace_with_managed_mysql_hostname
DB_PORT=replace_with_managed_mysql_port
DB_NAME=jrs_hr_module_dev_team
DB_USER=replace_with_your_individual_service_user
DB_PASSWORD=replace_with_your_individual_service_password

# Paste the provider CA certificate as a quoted multiline value.
# Keep certificate verification enabled; do not add an insecure TLS bypass.
DB_SSL_CA="-----BEGIN CERTIFICATE-----
replace_with_provider_ca_certificate
-----END CERTIFICATE-----"

# Runtime developers leave both values blank. The migration owner temporarily sets
# both values to the exact DB_NAME only while applying a reviewed migration.
DB_WRITE_CONFIRMED=
DB_SHARED_INTEGRATION_CONFIRMED=

SESSION_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
INTEGRATION_MODE=team
COMPANY_NAME=JRS
UPLOAD_DIR=./uploads
MAIL_MODE=preview
MAIL_ALLOW_SMTP=false

# Configure these only after the team login contract is implemented.
TEAM_LOGIN_URL=
TEAM_AUTH_ADAPTER=
