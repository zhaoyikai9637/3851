# Copy to server/.env. Use a NEW EMPTY database, not the earlier SQL database.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jrs_hr_module_dev_20260908
DB_USER=jrs_hr_module_local
DB_PASSWORD=replace_with_your_mysql_password
# Leave blank until the user confirms this is a NEW dedicated database.
# After confirmation only, set to exactly the same value as DB_NAME.
DB_WRITE_CONFIRMED=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
# standalone creates explicit development dependencies; team requires existing tables.
INTEGRATION_MODE=standalone
# Optional local-only temporary entry. Never configure this in production or team mode.
DEV_HR_USER_ID=1
COMPANY_NAME=JRS
SEED_PASSWORD=replace_with_your_development_password_12_chars_min
UPLOAD_DIR=./uploads
MAIL_MODE=preview
MAIL_ALLOW_SMTP=false
# SMTP is opt-in. No email is sent in preview mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Team owns sign-in. Leave blank until its contract exists; no automatic login.
# Absolute HTTP(S) login URL. Return URL parameters must be agreed with the team.
TEAM_LOGIN_URL=
# Local server-side adapter file relative to server/; exports createIdentityAdapter.
TEAM_AUTH_ADAPTER=
