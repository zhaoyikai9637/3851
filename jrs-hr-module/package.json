{
  "name": "jrs-hr-module", "version": "1.0.0", "private": true,
  "workspaces": ["client", "server"],
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "test": "npm run test -w server && npm run test -w client",
    "test:jest": "node scripts/run-jest-report.mjs",
    "test:mysql": "npm run test:mysql -w server",
    "docs:export": "node scripts/export-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {"concurrently": "^9.2.1"}
}
